{
  "name": "react-native-fsd-template",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0 expo start --lan",
    "start:local": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:dev": "expo start --dev-client --lan",
    "start:dev:tunnel": "expo start --dev-client --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "expo run:android",
    "build:ios": "expo run:ios",
    "eas:build:dev": "npx eas-cli@latest build --profile development",
    "eas:build:dev:android": "npx eas-cli@latest build --platform android --profile development",
    "eas:build:preview": "npx eas-cli@latest build --profile preview",
    "eas:build:release-apk": "npx eas-cli@latest build --platform android --profile release-apk-arm64",
    "eas:build:prod": "npx eas-cli@latest build --profile production",
    "eas:update": "npx eas-cli@latest update --channel preview --environment preview",
    "eas:update:development": "npx eas-cli@latest update --channel development --environment development",
    "eas:update:preview": "npx eas-cli@latest update --channel preview --environment preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/analytics": "^24.0.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.5",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.19.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~55.0.8",
    "dayjs": "^1.11.19",
    "expo": "^55.0.28",
    "expo-build-properties": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.22",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.16",
    "expo-system-ui": "~55.0.20",
    "expo-updates": "~55.0.26",
    "i18n-js": "^4.5.3",
    "lottie-react-native": "^7.3.6",
    "nativewind": "^4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  },
  "private": true
}
